{
  "name": "sud-ui",
  "description": "A React UI component library with dark mode support, customizable styles, reusable components, and utility-style class names.",
  "version": "2.0.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "style": "./dist/index.css"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-types.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run lint && npm test && npm run test:types && npm run check:exports && npm run check:package",
    "lint": "eslint .",
    "test": "vitest run",
    "test:types": "npm run build && tsc -p tests/types/tsconfig.json",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "sud-icons": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeeUSoon93/sud-lib.git"
  },
  "homepage": "https://sud.co.kr",
  "bugs": {
    "url": "https://github.com/SeeUSoon93/sud-lib/issues"
  },
  "keywords": [
    "react",
    "ui",
    "component-library",
    "react-ui",
    "design-system",
    "customizable",
    "dark-mode",
    "utility-class",
    "frontend",
    "react-components"
  ],
  "author": "SeeUSoon93",
  "license": "MIT",
  "packageManager": "npm@10.9.8"
}
